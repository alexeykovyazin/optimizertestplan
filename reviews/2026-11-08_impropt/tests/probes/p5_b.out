set planonly on; set explain on;
-- DOUBLE -0.05..0.05: real 50000, 1001, 50000
select count(*) from tu5 where d >= 0;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=49977.99)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where d between -0.01 and -0.009;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=1001.44)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where d < 0;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=50022.01)
            -> Table "TU5" Full Scan (rows=100000.00)
-- NUMERIC(9,4) 0..9.9999: real 10001, 50000
select count(*) from tu5 where nm between 1 and 2;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=9989.09)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where nm >= 5;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=49896.53)
            -> Table "TU5" Full Scan (rows=100000.00)
-- TIMESTAMP 1 row per second, 100000 s: real 56800, 3601
select count(*) from tu5 where ts >= timestamp '2020-01-01 12:00:00';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=56646.41)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where ts between timestamp '2020-01-01 01:00:00' and timestamp '2020-01-01 02:00:00';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=3594.05)
            -> Table "TU5" Full Scan (rows=100000.00)
-- R1 text unique UTF8: real 50000, 1000
select count(*) from tu5 where c >= 'k050000';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=100000.00)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where c between 'k050000' and 'k050999';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=25000.00)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where c < 'k050000';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=25000.00)
            -> Table "TU5" Full Scan (rows=100000.00)
-- R1 text unique NONE: real 50000, 1000
select count(*) from tu5 where cn >= 'k050000';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=50000.00)
            -> Table "TU5" Full Scan (rows=100000.00)
select count(*) from tu5 where cn between 'k050000' and 'k050999';

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=25000.00)
            -> Table "TU5" Full Scan (rows=100000.00)
-- tzi: same stats, natural vs index
select count(*) from tzi where y between 10000 and 10199 plan (tzi natural);

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=640.70)
            -> Table "TZI" Full Scan (rows=100000.00)
select count(*) from tzi where y between 10000 and 10199;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=640.70)
            -> Table "TZI" Access By ID (rows=640.70)
                -> Bitmap
                    -> Index "TZI_Y" Range Scan (lower bound: 1/1, upper bound: 1/1)
select count(*) from tzi where x between 50000 and 50999 plan (tzi natural);

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=998.38)
            -> Table "TZI" Full Scan (rows=100000.00)
select count(*) from tzi where x between 50000 and 50999;

Select Expression
    -> Aggregate (rows=1.00)
        -> Filter (rows=998.38)
            -> Table "TZI" Access By ID (rows=998.38)
                -> Bitmap
                    -> Index "TZI_X" Range Scan (lower bound: 1/1, upper bound: 1/1)
