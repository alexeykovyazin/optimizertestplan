-- growth: add 10000 rows above max, no refresh. real 10000, 1000
insert into tz select x + 100000, y, p from tz where x < 10000;

PLAN (TZ NATURAL)
commit;
set planonly on; set explain on;
select count(*) from tz where x >= 100000;

